#include <stdio.h>
#include <stdlib.h>

struct tlist {
	int value;
	struct tlist *next;
};
typedef struct tlist list;
// inicio do programa!

list *getDiff(list *l1, list *l2) 
{
	list *aux1,*aux2;
	list *l3, *aux, *firstl3=NULL;
	//
	for(aux1=l1; aux1!=NULL;aux1=aux1->next)
	{ // percorre l1
		for (aux2=l2;aux2!=NULL;aux2=aux2->next)
		{ // percorro l2 para cada elemento de l1
			if (aux1->value==aux2->value)
			{
				 break;
			}
		}
		if (aux2==NULL)
		{
			l3=(list *)malloc(sizeof(list)); // passo 1
			l3->value=aux1->value; // passo 2
			l3->next=NULL;      // passo 2
			if (firstl3==NULL) 
			{
				firstl3=l3;
				aux=l3;
		    }
		    else
		    {
				aux->next=l3;
				aux=l3;
		    }
			
	    }
	 }
	 return firstl3;    
}

